# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Add the same names in Vercel: Project > Settings > Environment Variables.
# Names starting with NEXT_PUBLIC_ are visible in the browser. Everything else stays on the server.

# The app's own address (http://localhost:3000 locally, your .vercel.app address in Vercel)
NEXT_PUBLIC_SITE_URL=

# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (or the legacy service_role key). Server only: skips row-level security.
SUPABASE_SECRET_KEY=

# Gemini (Google AI Studio). GEMINI_MODEL is optional (default gemini-2.5-flash).
GEMINI_API_KEY=
GEMINI_MODEL=

# Crustdata: find companies and people
CRUSTDATA_API_KEY=

# Olostep: read websites, web search
OLOSTEP_API_KEY=

# Google PageSpeed Insights (Google Cloud API key with "PageSpeed Insights API" turned on)
PAGESPEED_API_KEY=

# Switches for tools that cost credits. Leave empty (off) to only reuse saved results.
# Set to on only after deciding to spend credits.
CRUSTDATA_LIVE=
OLOSTEP_LIVE=

# Gmail API (Google Cloud OAuth client, for sending from the student's Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places API (New): phone numbers for businesses
GOOGLE_PLACES_API_KEY=
