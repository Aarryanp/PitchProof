# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Add the same names in Vercel: Project > Settings > Environment Variables.
# Names starting with NEXT_PUBLIC_ are visible in the browser. Everything else stays on the server.

# The app's own address (http://localhost:3000 locally, your .vercel.app address in Vercel)
NEXT_PUBLIC_SITE_URL=

# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (or the legacy service_role key). Server only: skips row-level security.
SUPABASE_SECRET_KEY=

# Gemini (Google AI Studio)
GEMINI_API_KEY=

# Crustdata: find companies and people
CRUSTDATA_API_KEY=

# Olostep: read websites, web search
OLOSTEP_API_KEY=

# Google PageSpeed Insights (Google Cloud API key)
PAGESPEED_API_KEY=

# Gmail API (Google Cloud OAuth client, for sending from the student's Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
